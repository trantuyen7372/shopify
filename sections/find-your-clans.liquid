{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #FindYourClans-{{ section.id }} {
    margin: 0 auto;
    max-width: 96rem;
  }

  #FindYourClans-{{ section.id }} .clan-directory {
    margin-bottom: 4.8rem;
  }

  #FindYourClans-{{ section.id }} .clan-directory:last-child {
    margin-bottom: 0;
  }

  #FindYourClans-{{ section.id }} .clan-directory__header {
    text-align: center;
    margin-bottom: 1.6rem;
  }

  #FindYourClans-{{ section.id }} .clan-directory__heading {
    margin: 0 0 0.6rem;
  }

  #FindYourClans-{{ section.id }} .clan-directory__subheading {
    color: rgba(var(--color-foreground), 0.72);
    margin: 0;
  }

  #FindYourClans-{{ section.id }} .clan-directory__search {
    margin: 0 auto 1.6rem;
    max-width: 36rem;
    position: relative;
  }

  #FindYourClans-{{ section.id }} .clan-directory__search-input {
    appearance: none;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: 0.4rem;
    color: rgb(var(--color-foreground));
    font: inherit;
    min-height: 4.4rem;
    padding: 0 1.2rem 0 4rem;
    width: 100%;
  }

  #FindYourClans-{{ section.id }} .clan-directory__search-icon {
    align-items: center;
    color: rgba(var(--color-foreground), 0.5);
    display: inline-flex;
    inset-inline-start: 1.4rem;
    pointer-events: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  #FindYourClans-{{ section.id }} .clan-directory__tabs {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.6rem;
    row-gap: 0.8rem;
    justify-content: center;
    margin-bottom: 2.4rem;
  }

  #FindYourClans-{{ section.id }} .clan-directory__tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: 0.4rem;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    font-size: 1.5rem;
    font-weight: 600;
    min-width: 3.2rem;
    padding: 0.5rem 0.9rem;
  }

  #FindYourClans-{{ section.id }} .clan-directory__tab[aria-selected='true'] {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  #FindYourClans-{{ section.id }} .clan-directory__tab-empty {
    align-items: center;
    color: rgba(var(--color-foreground), 0.28);
    display: inline-flex;
    font-size: 1.5rem;
    font-weight: 600;
    justify-content: center;
    min-width: 3.2rem;
    padding: 0.5rem 0.9rem;
  }

  #FindYourClans-{{ section.id }} .clan-directory__list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 550px) {
    #FindYourClans-{{ section.id }} .clan-directory__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #FindYourClans-{{ section.id }} .clan-directory__list {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  #FindYourClans-{{ section.id }} .clan-directory__item[hidden] {
    display: none;
  }

  #FindYourClans-{{ section.id }} .clan-directory__link {
    background: rgba(var(--color-foreground), 0.055);
    border-radius: 0.6rem;
    color: rgb(var(--color-foreground));
    display: block;
    padding: 1.1rem 1.4rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  #FindYourClans-{{ section.id }} .clan-directory__link:hover {
    background: rgba(var(--color-foreground), 0.1);
  }

  #FindYourClans-{{ section.id }} .clan-directory__empty {
    color: rgba(var(--color-foreground), 0.7);
    text-align: center;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div id="FindYourClans-{{ section.id }}">

      <div class="clan-directory" data-clan-directory>
        <div class="clan-directory__header">
          <h2 class="clan-directory__heading title h1">{{ section.settings.scottish_heading | escape }}</h2>
          <p class="clan-directory__subheading">{{ section.settings.scottish_subheading | escape }}</p>
        </div>
        <div class="clan-directory__search">
          <input
            type="search"
            class="clan-directory__search-input"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            autocomplete="off"
            data-directory-filter
          >
          <span class="clan-directory__search-icon">
            <span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span>
          </span>
        </div>
        <div class="clan-directory__tabs" role="tablist" aria-label="Browse Scottish clans by first letter" data-directory-tabs>
          {%- for letter in letter_order -%}
            {%- assign match_prefix = letter | append: ':' -%}
            {%- assign letter_has_entries = false -%}
            {%- for group in scottish_groups -%}
              {%- if group contains match_prefix -%}
                {%- assign letter_has_entries = true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if letter_has_entries -%}
              <button type="button" class="clan-directory__tab" role="tab" aria-selected="false" data-tab="{{ letter }}">{{ letter }}</button>
            {%- else -%}
              <span class="clan-directory__tab-empty">{{ letter }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <ul class="clan-directory__list" data-directory-list>
          {%- for group in scottish_groups -%}
            {%- assign parts = group | split: ':' -%}
            {%- assign letter = parts[0] -%}
            {%- assign names = parts[1] | split: ',' -%}
            {%- for name in names -%}
              {%- assign search_phrase = name | append: ' tartan' | prepend: '"' | append: '"' | url_encode -%}
              <li class="clan-directory__item" data-name="{{ name | escape }}" data-letter="{{ letter }}" hidden>
                <a class="clan-directory__link" href="{{ routes.search_url }}?q={{ search_phrase }}">{{ name }}</a>
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
        <p class="clan-directory__empty" data-directory-empty hidden>No clans found</p>
      </div>

      <div class="clan-directory" data-clan-directory>
        <div class="clan-directory__header">
          <h2 class="clan-directory__heading title h1">{{ section.settings.irish_heading | escape }}</h2>
          <p class="clan-directory__subheading">{{ section.settings.irish_subheading | escape }}</p>
        </div>
        <div class="clan-directory__search">
          <input
            type="search"
            class="clan-directory__search-input"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            autocomplete="off"
            data-directory-filter
          >
          <span class="clan-directory__search-icon">
            <span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span>
          </span>
        </div>
        <div class="clan-directory__tabs" role="tablist" aria-label="Browse Irish clans by first letter" data-directory-tabs>
          {%- for letter in letter_order -%}
            {%- assign match_prefix = letter | append: ':' -%}
            {%- assign letter_has_entries = false -%}
            {%- for group in irish_groups -%}
              {%- if group contains match_prefix -%}
                {%- assign letter_has_entries = true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if letter_has_entries -%}
              <button type="button" class="clan-directory__tab" role="tab" aria-selected="false" data-tab="{{ letter }}">{{ letter }}</button>
            {%- else -%}
              <span class="clan-directory__tab-empty">{{ letter }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <ul class="clan-directory__list" data-directory-list>
          {%- for group in irish_groups -%}
            {%- assign parts = group | split: ':' -%}
            {%- assign letter = parts[0] -%}
            {%- assign names = parts[1] | split: ',' -%}
            {%- for name in names -%}
              {%- assign search_phrase = name | append: ' tartan' | prepend: '"' | append: '"' | url_encode -%}
              <li class="clan-directory__item" data-name="{{ name | escape }}" data-letter="{{ letter }}" hidden>
                <a class="clan-directory__link" href="{{ routes.search_url }}?q={{ search_phrase }}">{{ name }}</a>
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
        <p class="clan-directory__empty" data-directory-empty hidden>No clans found</p>
      </div>

    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('FindYourClans-{{ section.id }}');
    if (!root) return;

    root.querySelectorAll('[data-clan-directory]').forEach((directory) => {
      const searchInput = directory.querySelector('[data-directory-filter]');
      const tabs = Array.from(directory.querySelectorAll('[data-tab]'));
      const items = Array.from(directory.querySelectorAll('[data-name]'));
      const emptyState = directory.querySelector('[data-directory-empty]');
      let activeLetter = tabs.length ? tabs[0].dataset.tab : null;

      const render = () => {
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
        let visibleCount = 0;

        items.forEach((item) => {
          const matchesSearch = query === '' || item.dataset.name.toLowerCase().includes(query);
          const matchesLetter = query !== '' || item.dataset.letter === activeLetter;
          const show = matchesSearch && matchesLetter;
          item.hidden = !show;
          if (show) visibleCount += 1;
        });

        if (emptyState) emptyState.hidden = visibleCount !== 0;
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          activeLetter = tab.dataset.tab;
          tabs.forEach((t) => t.setAttribute('aria-selected', t === tab ? 'true' : 'false'));
          if (searchInput) searchInput.value = '';
          render();
        });
      });

      if (tabs.length) tabs[0].setAttribute('aria-selected', 'true');
      if (searchInput) searchInput.addEventListener('input', render);
      render();
    });
  })();
</script>

